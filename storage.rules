rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Board images — any authenticated user can read/write
    match /boards/{boardId}/images/{imageName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Board documents (Documents box uploads) — same policy as images.
    // Recursive so each box can hold many timestamped files.
    match /boards/{boardId}/documents/{docPath=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
